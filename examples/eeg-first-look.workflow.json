      },
      "target": {
        "node_id": "epochs",
        "port_id": "reviewed"
      }
    },
    {
      "id": "e5",
      "source": {
        "node_id": "epochs",
        "port_id": "epochs"
      },
      "target": {
        "node_id": "erp",
        "port_id": "epochs"
      }
    },
    {
      "id": "e6",
      "source": {
        "node_id": "epochs",
        "port_id": "epochs"
      },
      "target": {
        "node_id": "psd",
        "port_id": "epochs"
      }
    },
    {
      "id": "e7",
      "source": {
        "node_id": "erp",
        "port_id": "evoked"
      },
      "target": {
        "node_id": "report",
        "port_id": "evoked"
      }
    },
    {
      "id": "e8",
      "source": {
        "node_id": "psd",
        "port_id": "spectrum"
      },
      "target": {
        "node_id": "report",
