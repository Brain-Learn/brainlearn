      },
      "target": {
        "node_id": "ica-fit",
        "port_id": "raw"
      }
    },
    {
      "id": "e10",
      "source": {
        "node_id": "ica-fit",
        "port_id": "ica"
      },
      "target": {
        "node_id": "ica",
        "port_id": "fit"
      }
    },
    {
      "id": "e4",
      "source": {
        "node_id": "ica",
